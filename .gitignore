/target

# Python build artefacts: the virtualenv `maturin develop` installs into, plus
# what the interpreter and pytest leave behind.
/.venv
**/__pycache__/
**/*.pyc
**/*.so
**/.pytest_cache/

# Default knowledge store directory created by every bound agent.
**/.agentwerk

# Malware-scanner working folder (tasks, knowledge, analysis output).
**/.malware-scanner

# Per-contributor integration-test env (see agentdocs/workflow.md).
.env
.env-local

# Downloaded packages under analysis (malware-scanner corpus).
/data
