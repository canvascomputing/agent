    def create_ticket_on_result(
        self, make: Callable[[Ticket], Optional[Ticket]]
    ) -> "TicketSystem": ...
    def on_ticket(
        self, callback: Callable[[Event, Ticket], Any]
    ) -> "TicketSystem": ...
    def edit_replies_on_event(
        self, editor: Callable[[list[Event], list[Reply]], Optional[list[Reply]]]
    ) -> "TicketSystem": ...
    def edit_replies(
        self, key: str, editor: Callable[[list[Reply]], Optional[list[Reply]]]
    ) -> "TicketSystem": ...
    def cancel_label(self, label: str) -> "TicketSystem": ...
    def label_cancelled(self, label: str) -> bool: ...
    def cancel_label_on_event(
        self, label: str, predicate: Callable[[Event], bool]
    ) -> "TicketSystem": ...
    def cancel_label_on_result(
        self, label: str, predicate: Callable[[Any], bool]
    ) -> "TicketSystem": ...
    def model_for_agent(self, agent_name: str) -> Optional[str]: ...
    def get_ticket(self, key: str) -> Optional[Ticket]: ...
    def tickets(self) -> list[Ticket]: ...
    def tickets_for_label(self, label: str) -> list[Ticket]: ...
    def find_tickets(self, predicate: Callable[[Ticket], bool]) -> list[Ticket]: ...
    def find_ticket(self, predicate: Callable[[Ticket], bool]) -> Optional[Ticket]: ...
    async def wait_for_ticket(
        self, predicate: Callable[[Ticket], bool]
    ) -> Optional[Ticket]: ...
    def start(self) -> "TicketSystem": ...
    async def finish(self) -> "TicketSystem": ...
    def cancel(self) -> None: ...
    def is_cancelled(self) -> bool: ...
    def finish_reason(self) -> Optional[str]: ...
    def stats(self) -> Stats: ...
    def last_result(self) -> Optional[Any]: ...
    def results(self) -> list[Any]: ...
    def results_for_label(self, label: str) -> list[Any]: ...
