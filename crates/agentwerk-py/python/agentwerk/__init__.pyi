"""Type stubs for the agentwerk Python bindings."""

from typing import Any, Awaitable, Callable, Optional, overload

class Provider:
    """An LLM provider handle."""

class Model:
    """A model name with optional context-window and reasoning-effort tuning."""

    def __init__(self, name: str) -> None: ...
    def context_window(self, size: int) -> "Model": ...
    def reasoning_effort(self, effort: str) -> "Model": ...
    def get_context_window(self) -> Optional[int]: ...
    def get_reasoning_effort(self) -> str: ...

def provider_from_env() -> Provider:
    """Detect and construct a provider from environment variables."""

def model_from_env() -> str:
    """Read the model name from the environment."""

def context_window_from_env() -> Optional[int]:
    """Read ``MODEL_CONTEXT_WINDOW``, or ``None`` when it is unset."""

def AnthropicProvider(
    api_key: str, base_url: Optional[str] = ..., timeout: Optional[float] = ...
) -> Provider: ...
def OpenAiProvider(
    api_key: str, base_url: Optional[str] = ..., timeout: Optional[float] = ...
) -> Provider: ...
def MistralProvider(
    api_key: str, base_url: Optional[str] = ..., timeout: Optional[float] = ...
) -> Provider: ...
def LiteLlmProvider(
    api_key: str, base_url: Optional[str] = ..., timeout: Optional[float] = ...
) -> Provider: ...

class Tool:
    """A built-in tool handle passed to Agent.tool(...)."""

class ToolResult:
    """What a tool reports back when a bare return value is not enough."""

    @staticmethod
    def success(content: str) -> "ToolResult": ...
    @staticmethod
    def error(content: str) -> "ToolResult": ...
    @staticmethod
    def schema_error(content: str) -> "ToolResult": ...

def ReadFileTool() -> Tool: ...
def WriteFileTool() -> Tool: ...
def EditFileTool() -> Tool: ...
def GrepTool() -> Tool:
    """Search file contents by regex, or a code shape via ``syntax="code"``."""
    ...
def GlobTool() -> Tool: ...
def ListDirectoryTool() -> Tool: ...
def FetchUrlTool() -> Tool: ...
def FindToolsTool() -> Tool: ...
def ManageKnowledgeTool(store: "Knowledge") -> Tool: ...
def ReadTicketsTool() -> Tool: ...
def ManageTicketsTool() -> Tool: ...
def FinishTool() -> Tool: ...
def BashTool(
    name: str,
    pattern: str,
    description: Optional[str] = ...,
    read_only: bool = ...,
) -> Tool: ...
def UnrestrictedBashTool() -> Tool: ...

@overload
def tool(func: Callable[..., Any]) -> Callable[..., Any]: ...
@overload
def tool(
    *,
    read_only: bool = ...,
    defer: bool = ...,
    paths: Optional[list[str]] = ...,
    schema: Optional[dict] = ...,
    name: Optional[str] = ...,
    description: Optional[str] = ...,
) -> Callable[[Callable[..., Any]], Callable[..., Any]]: ...

class Schema:
    def __init__(self, document: Any) -> None: ...
    def validate(self, value: Any) -> Any: ...

class ReplyContent:
    """One payload block inside a reply."""

    kind: str
    data: dict

    @staticmethod
    def text(text: str) -> "ReplyContent": ...
    @staticmethod
    def tool_use(id: str, name: str, input: Any) -> "ReplyContent": ...
    @staticmethod
    def tool_result(
        tool_use_id: str,
        content: str,
        succeeded: bool = ...,
        path: Optional[str] = ...,
    ) -> "ReplyContent": ...
    @staticmethod
    def thinking(thinking: str, signature: str) -> "ReplyContent": ...
    @staticmethod
    def redacted_thinking(data: str) -> "ReplyContent": ...
    def __repr__(self) -> str: ...

class Reply:
    """One entry in a ticket's replies."""

    author: str
    content: list[ReplyContent]
    created_at: int

    @staticmethod
    def user_text(text: str) -> "Reply": ...
    def __repr__(self) -> str: ...

class Ticket:
    key: str
    status: str
    task: Any
    result: Optional[Any]
    labels: list[str]
    schema: Optional[Schema]
    parent: Optional[str]
    reporter: str
    created_at: int
    started_at: Optional[int]
    finished_at: Optional[int]
    failed_at: Optional[int]
    replies: list[Reply]

    def __init__(
        self,
        task: Any,
        *,
        labels: Optional[list[str]] = ...,
        schema: Optional[Schema] = ...,
        parent: Optional[str] = ...,
    ) -> None: ...
    def has_label(self, label: str) -> bool: ...
    def is_todo(self) -> bool: ...
    def is_finished(self) -> bool: ...
    def is_failed(self) -> bool: ...
    def is_in_progress(self) -> bool: ...
    def is_pending(self) -> bool: ...
    def is_resolved(self) -> bool: ...
    def __repr__(self) -> str: ...

class Trajectory:
    key: str
    model: Optional[str]
    replies: list[Reply]

    @staticmethod
    def from_ticket(
        agent: str, model: Optional[str], ticket: Ticket
    ) -> "Trajectory": ...
    def save(self, dir: str) -> None: ...
    def __repr__(self) -> str: ...

class Page:
    slug: str
    kind: str
    description: str
    content: str
    tags: list[str]

    def __init__(
        self,
        slug: str,
        description: str,
        content: str,
        kind: str = ...,
        tags: Optional[list[str]] = ...,
    ) -> None: ...
    def __repr__(self) -> str: ...

class Pages:
    def save(self, page: Page) -> None: ...
    def load(self, slug: str) -> Page: ...
    def list(self) -> list[Page]: ...
    def remove(self, slug: str) -> None: ...

class Knowledge:
    @staticmethod
    def load(dir: str) -> "Knowledge": ...
    def index_char_limit(self, n: int) -> "Knowledge": ...
    def get_index_char_limit(self) -> int: ...
    def index(self) -> str: ...
    def pages(self) -> Pages: ...
    def clear(self) -> None: ...

class Event:
    kind: str
    agent_name: str
    ticket_key: str
    @property
    def data(self) -> dict: ...
    def __repr__(self) -> str: ...

class ToolStat:
    calls: int
    not_found: int
    execution_failed: int
    schema_failed: int

    def errors(self) -> int: ...
    def error_rate(self) -> Optional[float]: ...
    def __repr__(self) -> str: ...

class FileStat:
    opens: int
    failed: int

    def __repr__(self) -> str: ...

class KnowledgeStat:
    writes: int
    reads: int
    removes: int
    lists: int
    misses: int

    def __repr__(self) -> str: ...

class ModelStat:
    requests: int
    input_tokens: int
    output_tokens: int

    def __repr__(self) -> str: ...

class Stats:
    """Statistics for a run, or one label or agent within it. Durations are seconds."""

    def stats_for_label(self, label: str) -> "Stats": ...
    def stats_for_agent(self, agent_name: str) -> "Stats": ...
    def usage_history(self, ticket_key: str) -> list[dict]: ...
    def tool_stats(self) -> dict[str, ToolStat]: ...
    def file_stats(self) -> dict[str, FileStat]: ...
    def knowledge_stats(self) -> KnowledgeStat: ...
    def model_stats(self) -> dict[str, ModelStat]: ...
    def turns(self) -> int: ...
    def requests(self) -> int: ...
    def tool_calls(self) -> int: ...
    def errors(self) -> int: ...
    def event_counts(self) -> dict[str, int]: ...
    def input_tokens(self) -> int: ...
    def output_tokens(self) -> int: ...
    def tickets_created(self) -> int: ...
    def tickets_finished(self) -> int: ...
    def tickets_failed(self) -> int: ...
    def run_duration(self) -> Optional[float]: ...
    def tickets_success_rate(self) -> Optional[float]: ...
    def total_ticket_duration(self) -> float: ...
    def avg_ticket_duration(self) -> Optional[float]: ...
    def total_work_duration(self) -> float: ...
    def avg_work_duration(self) -> Optional[float]: ...
    def to_dict(self) -> dict: ...
    def __repr__(self) -> str: ...

class Agent:
    """Configured with the fluent methods, armed by ``build()``, then driven."""

    def __init__(self) -> None: ...
    @staticmethod
    def empty() -> "Agent": ...
    def from_env(self) -> "Agent": ...
    def provider_from_env(self) -> "Agent": ...
    def provider(self, provider: Provider) -> "Agent": ...
    def model(self, model: "str | Model") -> "Agent": ...
    def model_from_env(self) -> "Agent": ...
    def name(self, name: str) -> "Agent": ...
    def role(self, role: str) -> "Agent": ...
    def label(self, label: str) -> "Agent": ...
    def labels(self, labels: list[str]) -> "Agent": ...
    def interactive(self) -> "Agent": ...
    def template(self, key: str, value: str) -> "Agent": ...
    def templates(self, variables: dict[str, str]) -> "Agent": ...
    def dir(self, dir: str) -> "Agent": ...
    def knowledge(self, store: Knowledge) -> "Agent": ...
    def tool(self, tool: Any) -> "Agent": ...
    def tools(self, tools: list) -> "Agent": ...
    def edit_directive_on_failure(
        self, editor: Callable[[str, str], Optional[str]]
    ) -> "Agent": ...
    def build(self) -> "Agent": ...
    def task(self, task: Any) -> str: ...
    def ticket(self, ticket: Ticket) -> str: ...
    def ticket_system(self, system: "TicketSystem") -> "Agent": ...
    def start(self) -> "TicketSystem": ...
    async def finish(self) -> "TicketSystem": ...

class TicketSystem:
    def __init__(self) -> None: ...
    @staticmethod
    def load(dir: str) -> "TicketSystem": ...
    def agent(self, agent: Agent) -> "TicketSystem": ...
    def task(self, task: Any) -> str: ...
    def ticket(self, ticket: Ticket) -> str: ...
    def reply(self, key: str, content: str) -> "TicketSystem": ...
    def set_finished(self, key: str, result: Any) -> None: ...
    def set_failed(self, key: str) -> None: ...
    def max_turns(self, n: int) -> "TicketSystem": ...
    def max_input_tokens(self, n: int) -> "TicketSystem": ...
    def max_output_tokens(self, n: int) -> "TicketSystem": ...
    def max_request_tokens(self, n: int) -> "TicketSystem": ...
    def max_schema_retries(self, n: int) -> "TicketSystem": ...
    def max_request_retries(self, n: int) -> "TicketSystem": ...
    def max_time(self, seconds: float) -> "TicketSystem": ...
    def request_retry_delay(self, seconds: float) -> "TicketSystem": ...
    def get_max_turns(self) -> Optional[int]: ...
    def get_max_input_tokens(self) -> Optional[int]: ...
    def get_max_output_tokens(self) -> Optional[int]: ...
    def get_max_request_tokens(self) -> Optional[int]: ...
    def get_max_schema_retries(self) -> Optional[int]: ...
    def get_max_request_retries(self) -> int: ...
    def get_max_time(self) -> Optional[float]: ...
    def get_request_retry_delay(self) -> float: ...
    def dir(self, dir: str) -> "TicketSystem": ...
    def get_dir(self) -> str: ...
    def schema_for_label(self, label: str, schema: Schema) -> "TicketSystem": ...
    def on_event(self, callback: Callable[[Event], Any]) -> "TicketSystem": ...
    def cancel_on_event(self, predicate: Callable[[Event], bool]) -> "TicketSystem": ...
    def cancel_on_result(self, predicate: Callable[[Any], bool]) -> "TicketSystem": ...
