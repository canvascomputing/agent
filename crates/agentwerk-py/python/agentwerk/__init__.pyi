"""Type stubs for the agentwerk Python bindings."""

from typing import Any, Callable, Optional, overload

class Provider:
    """An LLM provider handle."""

class Model:
    """A model name with optional context-window and reasoning-effort tuning."""

    def __init__(self, name: str) -> None: ...
    def context_window(self, size: int) -> "Model": ...
    def reasoning_effort(self, effort: str) -> "Model": ...

def provider_from_env() -> Provider:
    """Detect and construct a provider from environment variables."""

def AnthropicProvider(api_key: str, base_url: Optional[str] = ...) -> Provider: ...
def OpenAiProvider(api_key: str, base_url: Optional[str] = ...) -> Provider: ...
def MistralProvider(api_key: str, base_url: Optional[str] = ...) -> Provider: ...
def LiteLlmProvider(api_key: str, base_url: Optional[str] = ...) -> Provider: ...

class Tool:
    """A built-in tool handle passed to Agent.tool(...)."""

def ReadFileTool() -> Tool: ...
def WriteFileTool() -> Tool: ...
def EditFileTool() -> Tool: ...
def GrepTool() -> Tool:
    """Search file contents by regex, or a code shape via ``syntax="code"``."""
    ...
def GlobTool() -> Tool: ...
def ListDirectoryTool() -> Tool: ...
def FetchUrlTool() -> Tool: ...
def ReadTicketsTool() -> Tool: ...
def ManageTicketsTool() -> Tool: ...
def BashTool(
    name: str,
    pattern: str,
    description: Optional[str] = ...,
    read_only: bool = ...,
) -> Tool: ...
def UnrestrictedBashTool() -> Tool: ...

@overload
def tool(func: Callable[..., Any]) -> Callable[..., Any]: ...
@overload
def tool(
    *,
    read_only: bool = ...,
    schema: Optional[dict] = ...,
    name: Optional[str] = ...,
    description: Optional[str] = ...,
) -> Callable[[Callable[..., Any]], Callable[..., Any]]: ...

class Schema:
    def __init__(self, document: Any) -> None: ...

class Ticket:
    def __init__(self, task: Any) -> None: ...
    def label(self, label: str) -> "Ticket": ...
    def labels(self, labels: list[str]) -> "Ticket": ...
    def schema(self, schema: Schema) -> "Ticket": ...
    def parent(self, key: str) -> "Ticket": ...

class Knowledge:
    @staticmethod
    def load(dir: str) -> "Knowledge": ...
    def index_char_limit(self, n: int) -> "Knowledge": ...
    def index(self) -> str: ...
    def clear(self) -> None: ...

class Event:
    kind: str
    agent_name: str
    ticket_key: str
    @property
    def data(self) -> dict: ...

class Agent:
    """The fluent agent builder."""

    def __init__(self) -> None: ...
    def from_env(self) -> "Agent": ...
    def provider_from_env(self) -> "Agent": ...
    def provider(self, provider: Provider) -> "Agent": ...
    def model(self, model: "str | Model") -> "Agent": ...
    def model_from_env(self) -> "Agent": ...
    def name(self, name: str) -> "Agent": ...
    def role(self, role: str) -> "Agent": ...
    def context(self, context: str) -> "Agent": ...
    def label(self, label: str) -> "Agent": ...
    def labels(self, labels: list[str]) -> "Agent": ...
    def interactive(self) -> "Agent": ...
    def template_variable(self, key: str, value: str) -> "Agent": ...
    def dir(self, dir: str) -> "Agent": ...
    def knowledge(self, store: Knowledge) -> "Agent": ...
    def tool(self, tool: Any) -> "Agent": ...
    def build(self) -> "BuiltAgent": ...

class BuiltAgent:
    """A built agent bound to its private ticket system."""

    def task(self, task: Any) -> str: ...
    def start(self) -> "TicketSystem": ...
    async def finish(self) -> "TicketSystem": ...

class TicketSystem:
    def __init__(self) -> None: ...
    @staticmethod
    def load(dir: str) -> "TicketSystem": ...
    def agent(self, agent: BuiltAgent) -> "TicketSystem": ...
    def task(self, task: Any) -> str: ...
    def ticket(self, ticket: Ticket) -> str: ...
    def reply(self, key: str, content: str) -> "TicketSystem": ...
    def max_turns(self, n: int) -> "TicketSystem": ...
    def max_input_tokens(self, n: int) -> "TicketSystem": ...
    def max_output_tokens(self, n: int) -> "TicketSystem": ...
    def max_request_tokens(self, n: int) -> "TicketSystem": ...
    def max_schema_retries(self, n: int) -> "TicketSystem": ...
    def max_request_retries(self, n: int) -> "TicketSystem": ...
    def max_time(self, seconds: float) -> "TicketSystem": ...
    def request_retry_delay(self, seconds: float) -> "TicketSystem": ...
    def dir(self, dir: str) -> "TicketSystem": ...
    def schema_for_label(self, label: str, schema: Schema) -> "TicketSystem": ...
    def on_event(self, callback: Callable[[Event], Any]) -> "TicketSystem": ...
    def cancel_on_event(self, predicate: Callable[[Event], bool]) -> "TicketSystem": ...
    def cancel_on_result(self, predicate: Callable[[Any], bool]) -> "TicketSystem": ...
    def create_ticket_on_result(
        self, make: Callable[[dict], Optional[Ticket]]
    ) -> "TicketSystem": ...
    def save_trajectory_on_event(
        self, predicate: Callable[[Event], bool]
    ) -> "TicketSystem": ...
    def cancel_label(self, label: str) -> "TicketSystem": ...
    def get_ticket(self, key: str) -> Optional[dict]: ...
    def tickets(self) -> list[dict]: ...
    def find_tickets(self, predicate: Callable[[dict], bool]) -> list[dict]: ...
    def find_ticket(self, predicate: Callable[[dict], bool]) -> Optional[dict]: ...
    async def wait_for_ticket(
        self, predicate: Callable[[dict], bool]
    ) -> Optional[dict]: ...
    def start(self) -> "TicketSystem": ...
    async def finish(self) -> "TicketSystem": ...
    def cancel(self) -> None: ...
    def is_cancelled(self) -> bool: ...
    def finish_reason(self) -> Optional[str]: ...
    def stats(self) -> dict: ...
    def last_result(self) -> Optional[Any]: ...
    def results(self) -> list[Any]: ...
    def results_for_label(self, label: str) -> list[Any]: ...
